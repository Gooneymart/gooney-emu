# Root Rust target and build artifacts
target/
**/.DS_Store
 
# Ignore any user project directories or build artifacts nested inside the custom extension slots
extensions/custom-*/*/*
extensions/custom-*/target/
extensions/custom-*/Cargo.lock

# Gooney-Emu Compiled Plugins & Extension Build Artifacts
crates/gooney-core/plugins/*.so
extensions/**/target/
extensions/**/.connected

# HDL Workspace: Ignore heavy build artifacts, keep documentation
hdl/*
!hdl/ANALYZE.md
!hdl/COSIM.md

# Firmware Tests: Ignore source test binaries, but track the directory structure
tests/*
!tests/README.md

# Logs & Temporary Files
*.log
*.tmp
*.dump
cargo_errors.log

# Nix environment artifacts
.direnv/
.nix-profile

# FPGA stuff
crates/gooney-fpga/verification/*
!verification.md

